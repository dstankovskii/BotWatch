# скопировать в secrets.env (он в .gitignore), заменить значения и создать Secret:
# kubectl -n botwatch create secret generic botwatch-secrets --from-env-file=deploy/k8s/secrets.env
# значения без кавычек: --from-env-file берёт строку после = как есть

POSTGRES_PASSWORD=change-me
GATEWAY_DB_PASSWORD=change-me
MONITORING_DB_PASSWORD=change-me
INCIDENTS_DB_PASSWORD=change-me
TGPROBE_DB_PASSWORD=change-me

RABBITMQ_USER=botwatch
RABBITMQ_PASSWORD=change-me
# то же самое одной строкой, для KEDA: она смотрит длину очереди http-probe
RABBITMQ_URL=amqp://botwatch:change-me@rabbitmq.botwatch.svc.cluster.local:5672/

# openssl rand -base64 32. потеряете - токены ботов и сессии аккаунтов придётся вводить заново
ENCRYPTION_KEY=

# приложение Telegram с https://my.telegram.org
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# если Telegram с сервера недоступен напрямую, одно из двух
TELEGRAM_PROXY=
TELEGRAM_MTPROXY_URL=

# dead man's switch, например https://hc-ping.com/<uuid>. пусто - выключено
HEARTBEAT_URL=
