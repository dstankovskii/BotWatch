# скопировать в .env и заменить все значения

POSTGRES_PASSWORD=change-me
GATEWAY_DB_PASSWORD=change-me
MONITORING_DB_PASSWORD=change-me
INCIDENTS_DB_PASSWORD=change-me
TGPROBE_DB_PASSWORD=change-me

RABBITMQ_USER=botwatch
RABBITMQ_PASSWORD=change-me

# приложение Telegram с https://my.telegram.org (API development tools).
# сами аккаунты-проверяльщики входят по QR, номер и коды здесь не нужны
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# если Telegram с сервера недоступен напрямую. одно из двух:
# TELEGRAM_PROXY=socks5://user:pass@host:1080
# TELEGRAM_MTPROXY_URL=https://t.me/proxy?server=...&port=...&secret=...

# ключ шифрования токенов и сессий, 32 байта в base64: openssl rand -base64 32
# потеряете ключ - токены ботов и сессии аккаунтов придётся вводить заново
ENCRYPTION_KEY=
