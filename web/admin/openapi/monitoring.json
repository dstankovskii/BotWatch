  "components": {
    "schemas": {
      "AccountDto": {
        "required": [
          "id",
          "displayName",
          "status",
          "telegramName",
          "lastError",
          "throttledUntil",
          "qrReady",
          "checksCount",
          "messagesPerHour",
          "messagesPerHourLimit",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/AccountStatus"
          },
          "telegramName": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastError": {
            "type": [
              "null",
              "string"
            ]
          },
          "throttledUntil": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "qrReady": {
            "type": "boolean"
          },
          "checksCount": {
            "type": "integer",
            "format": "int32"
          },
          "messagesPerHour": {
            "type": "number",
            "format": "double"
          },
          "messagesPerHourLimit": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AccountStatus": {
        "enum": [
          "PendingLogin",
          "Active",
          "LoginFailed",
          "Revoked"
        ]
      },
      "CheckDto": {
        "required": [
          "id",
          "name",
          "intervalSeconds",
          "enabled",
          "nextRunAt",
          "lastScheduledAt",
          "http",
          "telegram"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "intervalSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "enabled": {
            "type": "boolean"
          },
          "nextRunAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastScheduledAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "http": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HttpCheckDto"
              }
            ]
          },
          "telegram": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TelegramCheckDto"
              }
            ]
          }
        }
      },
      "CreateAccountRequest": {
        "required": [
          "displayName"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          }
        }
      },
      "CreateMonitorRequest": {
        "required": [
          "name",
          "kind",
          "target"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/MonitorKind"
          },
          "target": {
            "type": "string"
          }
        }
      },
      "HttpCheckDto": {
        "required": [
          "path",
          "method",
          "expectedStatus",
          "bodyContains",
          "timeoutSeconds"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "expectedStatus": {
            "type": "integer",
            "format": "int32"
          },
          "bodyContains": {
            "type": [
              "null",
              "string"
            ]
          },
          "timeoutSeconds": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HttpCheckRequest": {
        "required": [
          "name",
          "intervalSeconds",
          "path",
          "method",
          "expectedStatus",
          "bodyContains",
          "timeoutSeconds"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "intervalSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "path": {
            "type": [
              "null",
              "string"
            ]
          },
          "method": {
            "type": [
              "null",
              "string"
            ]
          },
          "expectedStatus": {
            "type": "integer",
            "format": "int32"
          },
          "bodyContains": {
            "type": [
              "null",
              "string"
            ]
          },
          "timeoutSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "MonitorDto": {
        "required": [
          "id",
          "name",
          "kind",
          "target",
          "enabled",
          "isPublic",
          "createdAt",
          "checks"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/MonitorKind"
          },
          "target": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "isPublic": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckDto"
            }
          }
        }
      },
      "MonitorKind": {
        "enum": [
          "Http",
          "TelegramBot"
        ]
      },
      "PublicMonitorDto": {
        "required": [
          "id",
          "name",
          "checkIds"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "checkIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ReplyCondition": {
        "enum": [
          "Any",
          "Contains",
          "Regex",
          "HasButton",
          "IsVoice",
          "HasFile",
          null
        ]
      },
      "ScenarioStep": {
        "required": [
          "kind"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/StepKind"
          },
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "phrases": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "voice": {
            "type": [
              "null",
              "string"
            ],
            "format": "byte"
          },
          "timeoutSeconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "condition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReplyCondition"
              }
            ]
          }
        }
      },
      "StepDto": {
        "required": [
          "kind",
          "text",
          "phrases",
          "voiceBytes",
          "timeoutSeconds",
          "condition"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/StepKind"
          },
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "phrases": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "voiceBytes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "timeoutSeconds": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "condition": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ReplyCondition"
              }
            ]
          }
        }
      },
      "StepKind": {
        "enum": [
          "SendText",
          "SendCommand",
          "SendRandom",
          "SendVoice",
          "ClickButton",
          "ExpectReply"
        ]
      },
      "TelegramCheckDto": {
        "required": [
          "accountId",
          "messagesPerRun",
          "steps"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "messagesPerRun": {
            "type": "integer",
            "format": "int32"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepDto"
            }
          }
        }
      },
      "TelegramCheckRequest": {
        "required": [
          "name",
          "intervalSeconds",
          "accountId",
          "steps"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "intervalSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScenarioStep"
            }
          },
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "UpdateMonitorRequest": {
        "required": [
          "name",
          "target",
          "enabled",
          "isPublic"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "isPublic": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
