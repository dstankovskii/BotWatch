{
  "openapi": "3.1.1",
  "info": {
    "title": "BotWatch.Incidents.Api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/api/states": {
      "get": {
        "tags": [
          "IncidentEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CheckStateDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/checks/{checkId}/results": {
      "get": {
        "tags": [
          "IncidentEndpoints"
        ],
        "parameters": [
          {
            "name": "checkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CheckResultDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/incidents": {
      "get": {
        "tags": [
          "IncidentEndpoints"
        ],
        "parameters": [
          {
            "name": "openOnly",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IncidentDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/uptime": {
      "get": {
        "tags": [
          "IncidentEndpoints"
        ],
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UptimeDayDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/channels": {
      "get": {
        "tags": [
          "ChannelEndpoints"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChannelDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "ChannelEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChannelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/channels/{id}": {
      "put": {
        "tags": [
          "ChannelEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateChannelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "ChannelEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/channels/{id}/test": {
      "post": {
        "tags": [
          "ChannelEndpoints"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChannelDto": {
        "required": [
          "id",
          "name",
          "botToken",
          "chatId",
          "enabled",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "botToken": {
            "type": "string"
          },
          "chatId": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CheckResultDto": {
        "required": [
          "jobId",
          "success",
          "durationMs",
          "error",
          "probe",
          "startedAt",
          "finishedAt"
        ],
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "success": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "probe": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CheckStateDto": {
        "required": [
          "checkId",
          "monitorId",
          "monitorName",
          "checkName",
          "enabled",
          "status",
          "statusChangedAt",
          "lastResultAt",
          "lastError",
          "openIncidentId"
        ],
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "format": "uuid"
          },
          "monitorId": {
            "type": "string",
            "format": "uuid"
          },
          "monitorName": {
            "type": "string"
          },
          "checkName": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "statusChangedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastResultAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastError": {
            "type": [
              "null",
              "string"
            ]
          },
          "openIncidentId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "CheckStatus": {
        "enum": [
          "Unknown",
          "Up",
          "Down",
          "Stale"
        ]
      },
      "CreateChannelRequest": {
        "required": [
          "name",
          "botToken",
          "chatId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "botToken": {
            "type": "string"
          },
          "chatId": {
            "type": "string"
          }
        }
      },
      "IncidentDto": {
        "required": [
          "id",
          "checkId",
          "monitorId",
          "cause",
          "openedAt",
          "resolvedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "checkId": {
            "type": "string",
            "format": "uuid"
          },
          "monitorId": {
            "type": "string",
            "format": "uuid"
          },
          "cause": {
            "type": [
              "null",
              "string"
            ]
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "UpdateChannelRequest": {
        "required": [
          "name",
          "botToken",
          "chatId",
          "enabled"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "botToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "chatId": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "UptimeDayDto": {
        "required": [
          "checkId",
          "day",
          "total",
          "failed",
          "avgDurationMs"
        ],
        "type": "object",
        "properties": {
          "checkId": {
            "type": "string",
            "format": "uuid"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "failed": {
            "type": "integer",
            "format": "int64"
          },
          "avgDurationMs": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "IncidentEndpoints"
    },
    {
      "name": "ChannelEndpoints"
    }
  ]
}
